---
interface Props { size?: number; withText?: boolean }
const { size = 22, withText = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="4" cy="5" r="1.6" fill="currentColor" /><circle cx="9.3" cy="5" r="1.6" fill="currentColor" />
    <circle cx="14.7" cy="5" r="1.6" fill="currentColor" /><circle cx="20" cy="5" r="1.6" fill="currentColor" />
    <rect x="2" y="9.5" width="20" height="3.2" fill="currentColor" />
    <rect x="2" y="14.6" width="20" height="1.4" fill="currentColor" />
    <rect x="2" y="18" width="20" height="4" fill="currentColor" opacity=".45" />
  </svg>
  {withText && <span class="logo__text">STRATE</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__text { font-family: var(--font-display); font-stretch: 125%; font-weight: 600; letter-spacing: 0.28em; font-size: 1rem; line-height: 1; }
</style>
