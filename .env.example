# ── Site ─────────────────────────────────────────────
# URL publique (canonical, sitemap, Open Graph)
SITE_URL=https://www.strate.fr
# true en préproduction : robots.txt bloque tout et chaque page est en noindex
PUBLIC_NOINDEX=true
# Google Tag Manager (GA4, Google Ads et Meta Pixel se configurent dans GTM)
PUBLIC_GTM_ID=
# Facultatif : autre point de réception que /api/lead/ (laisser vide)
PUBLIC_LEAD_ENDPOINT=

# ── Brevo (secrets serveur : ne jamais préfixer par PUBLIC_) ──
# Clé API : Brevo > SMTP & API > Clés API
BREVO_API_KEY=
# Valeurs ci-dessous fournies par : node --env-file=.env scripts/brevo-setup.mjs
BREVO_ATTR_FIRSTNAME=PRENOM
BREVO_ATTR_LASTNAME=NOM
BREVO_LIST_LEADS=
BREVO_LIST_NEWSLETTER=
BREVO_PIPELINE_ID=
BREVO_STAGE_NEW=
BREVO_TASK_TYPE_CALL=
# Email (ou id) du commercial à qui sont attribués deals et tâches
BREVO_DEAL_OWNER=

# ── Emails et SMS ────────────────────────────────────
# Expéditeur vérifié dans Brevo (domaine authentifié SPF/DKIM recommandé)
LEAD_SENDER_EMAIL=
LEAD_SENDER_NAME=STRATE
# Adresse qui reçoit les réponses des prospects
LEAD_REPLY_TO=
# Équipe à prévenir à chaque demande (séparer par des virgules)
TEAM_NOTIFY_EMAILS=
# Facultatif : numéros à prévenir par SMS, format international (ex. 33612345678)
TEAM_NOTIFY_SMS=
# Nom d'expéditeur SMS (11 caractères max)
SMS_SENDER=STRATE

# ── Avis Google (lus au build) ───────────────────────
# Clé API Google Cloud avec « Places API (New) » activée, et identifiant de la fiche Google Business
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Assistant conversationnel (Claude) ───────────────
# true pour afficher l'assistant sur le site (lu au build)
PUBLIC_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
# Modèle et niveau d'effort (low conseillé pour une conversation)
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low

# ── STRATE Vision (visualisation IA) ─────────────────
OPENAI_API_KEY=
VISION_MODEL=gpt-image-2
# low | medium | high : qualité et coût du rendu
VISION_QUALITY=medium
# local : texture de démonstration sans appel externe (développement uniquement)
VISION_PROVIDER=

# ── Facultatif ───────────────────────────────────────
# Relais de chaque demande vers n8n (automatisations complémentaires)
N8N_WEBHOOK_URL=
